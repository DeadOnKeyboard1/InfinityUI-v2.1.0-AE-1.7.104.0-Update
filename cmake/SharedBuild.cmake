if(NOT DEFINED INFINITY_TOOLCHAIN)
    if(DEFINED ENV{SKSE_TOOLCHAIN_ROOT})
        file(TO_CMAKE_PATH "$ENV{SKSE_TOOLCHAIN_ROOT}" INFINITY_TOOLCHAIN)
    else()
        get_filename_component(INFINITY_TOOLCHAIN "${CMAKE_CURRENT_SOURCE_DIR}/../_toolchain" ABSOLUTE)
    endif()
endif()
set(_deps "${INFINITY_TOOLCHAIN}/skyrim_1_7_104_compat/deps-msvc1951")
list(PREPEND CMAKE_PREFIX_PATH "${_deps}" "${INFINITY_TOOLCHAIN}/vcpkg-installed/x64-windows-static-md")
set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreadedDLL)
set(CMAKE_CXX_FLAGS_RELEASE "/O2 /Ob2 /DNDEBUG /Z7")
set(CMAKE_C_FLAGS_RELEASE "/O2 /Ob2 /DNDEBUG /Z7")
file(TO_CMAKE_PATH "${CMAKE_CURRENT_SOURCE_DIR}" _privacy_source)
file(TO_CMAKE_PATH "${INFINITY_TOOLCHAIN}" _privacy_tools)
string(REGEX REPLACE "/+$" "" _privacy_source "${_privacy_source}")
string(REGEX REPLACE "/+$" "" _privacy_tools "${_privacy_tools}")
add_compile_options(/utf-8 /experimental:deterministic "/pathmap:${_privacy_source}/=>DoK</InfinityUI" "/pathmap:${_privacy_tools}/=>DoK</dependencies")
add_link_options(/Brepro /INCREMENTAL:NO /DEBUG:FULL /PDBALTPATH:%_PDB%)
set(ENABLE_SKYRIM_SE ON CACHE BOOL "" FORCE)
set(ENABLE_SKYRIM_AE ON CACHE BOOL "" FORCE)
set(ENABLE_SKYRIM_VR OFF CACHE BOOL "" FORCE)
set(SKSE_SUPPORT_XBYAK ON CACHE BOOL "" FORCE)
set(COMMONLIB_PREBUILT OFF CACHE BOOL "" FORCE)
set(COMMONLIB_ENABLE_IPO OFF CACHE BOOL "" FORCE)
set(BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(FETCHCONTENT_FULLY_DISCONNECTED ON CACHE BOOL "" FORCE)
set(FETCHCONTENT_SOURCE_DIR_HDE64 "${INFINITY_TOOLCHAIN}/minhook-v1.3.4" CACHE PATH "" FORCE)
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/rapidcsv-include")
configure_file("${INFINITY_TOOLCHAIN}/vcpkg-installed/x64-windows-static-md/include/rapidcsv.h"
    "${CMAKE_CURRENT_BINARY_DIR}/rapidcsv-include/rapidcsv.h" COPYONLY)
set(RAPIDCSV_INCLUDE_DIRS "${CMAKE_CURRENT_BINARY_DIR}/rapidcsv-include" CACHE PATH "" FORCE)
add_subdirectory("${INFINITY_TOOLCHAIN}/CommonLibSSE-NG-v12.2.0" "${CMAKE_CURRENT_BINARY_DIR}/commonlib")
target_include_directories(CommonLibSSE SYSTEM PUBLIC "${INFINITY_TOOLCHAIN}/vcpkg-installed/x64-windows-static-md/include/directxmath")
target_include_directories(CommonLibSSE SYSTEM PUBLIC "${INFINITY_TOOLCHAIN}/ied-build-deps/xbyak")
