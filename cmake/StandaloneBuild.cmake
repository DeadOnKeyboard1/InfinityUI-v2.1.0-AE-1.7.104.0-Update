find_package(Git REQUIRED)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${INFINITY_COMMONLIB_SOURCE_DIR}" rev-parse HEAD
    RESULT_VARIABLE _revision_result OUTPUT_VARIABLE _revision OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT _revision_result EQUAL 0 OR NOT _revision STREQUAL "67b201b6fe45241ac5c1e4630ecf847523775b66")
    message(FATAL_ERROR "Use the documented exact CommonLibSSE-NG v12.2.0 checkout")
endif()
set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreadedDLL)
set(ENABLE_SKYRIM_SE ON CACHE BOOL "" FORCE)
set(ENABLE_SKYRIM_AE ON CACHE BOOL "" FORCE)
set(ENABLE_SKYRIM_VR OFF CACHE BOOL "" FORCE)
set(COMMONLIB_PREBUILT OFF CACHE BOOL "" FORCE)
set(COMMONLIB_ENABLE_IPO OFF CACHE BOOL "Parent configures Release IPO" FORCE)
set(BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(SKSE_SUPPORT_XBYAK ON CACHE BOOL "" FORCE)
set(SKSE_SUPPORT_PATCH_SAFETY ON CACHE BOOL "" FORCE)
find_path(_INFINITY_CSV_ROOT rapidcsv.h REQUIRED)
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/rapidcsv-include")
configure_file("${_INFINITY_CSV_ROOT}/rapidcsv.h" "${CMAKE_CURRENT_BINARY_DIR}/rapidcsv-include/rapidcsv.h" COPYONLY)
set(RAPIDCSV_INCLUDE_DIRS "${CMAKE_CURRENT_BINARY_DIR}/rapidcsv-include" CACHE PATH "Isolated CSV header" FORCE)
find_package(directxmath CONFIG REQUIRED)
set(INFINITY_XBYAK_SOURCE_DIR "" CACHE PATH "Optional Xbyak source checkout")
if(INFINITY_XBYAK_SOURCE_DIR)
    add_subdirectory("${INFINITY_XBYAK_SOURCE_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/xbyak")
else()
    find_package(xbyak CONFIG REQUIRED)
endif()
if(MSVC)
    string(TOLOWER "${CMAKE_CURRENT_BINARY_DIR}" _infinity_build_lower)
    add_compile_options(/utf-8 /Z7 /experimental:deterministic
        "/pathmap:${CMAKE_CURRENT_SOURCE_DIR}/=>DoK</InfinityUI"
        "/pathmap:${CMAKE_CURRENT_BINARY_DIR}/=>DoK</build"
        "/pathmap:${_infinity_build_lower}/=>DoK</build"
        "/pathmap:${INFINITY_COMMONLIB_SOURCE_DIR}/=>DoK</CommonLibSSE-NG")
    if(INFINITY_XBYAK_SOURCE_DIR)
        add_compile_options("/pathmap:${INFINITY_XBYAK_SOURCE_DIR}/=>DoK</xbyak")
    endif()
    add_link_options(/Brepro /INCREMENTAL:NO /PDBALTPATH:%_PDB%)
endif()
add_subdirectory("${INFINITY_COMMONLIB_SOURCE_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/commonlib")
set_property(TARGET CommonLibSSE PROPERTY INTERPROCEDURAL_OPTIMIZATION_RELEASE ON)
target_link_libraries(CommonLibSSE PUBLIC Microsoft::DirectXMath xbyak::xbyak)
